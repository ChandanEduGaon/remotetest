PORT=3000

# mysql (production/VPS) or sqlite (zero-install local dev, uses node:sqlite)
DB_CLIENT=mysql

# Only used when DB_CLIENT=sqlite
SQLITE_PATH=./data/dev.sqlite3

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=remotetest

# Public base URL used when building shareable page links (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000
